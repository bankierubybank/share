# Copy to .env.test (git-ignored) and fill in a Cloudflare Access *service token*
# (Zero Trust → Access → Service Auth → Service Tokens → Create).
# Then add a policy on the "share" Access application: Action = "Service Auth", Include = "Service Token" → this token.
# Test scripts send these as CF-Access-Client-Id / CF-Access-Client-Secret headers.
CF_ACCESS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.access
CF_ACCESS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Production URL used by `npm run test:prod`.
PROD_URL=https://share.bankierubybank.workers.dev
