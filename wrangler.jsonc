{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "share",
  "account_id": "d20bca6d49889066d98d858a37f6837e",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "share-db",
      "database_id": "fc72d57c-394e-4be1-b1b7-009f9c68fd4e",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    // Set both to enforce Cloudflare Access JWT verification inside the Worker (see docs/ACCESS.md).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
