{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "share",
  "account_id": "d20bca6d49889066d98d858a37f6837e",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; pages/bundles come straight from the edge (headers: web/public/_headers).
    // Lets Smart Placement move the API next to D1 without slowing page loads (docs/ARCHITECTURE.md → Performance).
    "run_worker_first": ["/api/*"]
  },
  // Each API request makes several D1 round trips; run it near the database (APAC primary) instead of near the user.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "share-db",
      "database_id": "fc72d57c-394e-4be1-b1b7-009f9c68fd4e",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "RECEIPTS", "bucket_name": "share-receipts" },
    { "binding": "BACKUPS", "bucket_name": "share-backups" }
  ],
  // Per-identity limits (src/index.ts → rate limit). Approximate, counted per Cloudflare location.
  // API: every /api request (600/min). LINKS: /api/join + /api/view, tokens someone might try to guess (30/min).
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "7301", "simple": { "limit": 600, "period": 60 } },
    { "name": "LINK_LIMIT", "namespace_id": "7302", "simple": { "limit": 30, "period": 60 } }
  ],
  // Daily: D1 backup to R2, materialize due recurring bills, purge bills deleted > 30 days ago.
  "triggers": { "crons": ["17 0 * * *"] },
  "vars": {
    // Cloudflare Access JWT verification inside the Worker — REQUIRED since v0.4: the verified identity decides
    // which trips a caller can open (docs/ACCESS.md). Not secrets (AUD tag + team domain are public identifiers).
    // Local dev / tests run with `--var DEV_IDENTITY:1` instead (header-based identity); never set that here.
    "ACCESS_TEAM_DOMAIN": "bankierubybank.cloudflareaccess.com",
    "ACCESS_AUD": "41642e58f024d0c0fa8bdc766ff86e500c26dcc2cdda30dd2faa6e6144ca6e60"
  },
  "observability": { "enabled": true }
}
